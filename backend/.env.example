APP_NAME=APP_NAME
SERVER_PORT=SERVER_PORT

DB_NAME=DB_NAME
DB_USER=DB_USER
DB_PASSWORD=DB_PASSWORD
DB_PORT=DB_PORT
DB_URL=DB_URL
DDL_AUTO=DDL_AUTO

JWT_SECRET=JWT_SECRET
JWT_EXPIRATION_MINUTES=JWT_EXPIRATION_MINUTES
# Attribut Secure du cookie de session : a laisser a false en developpement
# (application servie en clair), a passer a true avec le HTTPS.
COOKIE_SECURE=COOKIE_SECURE

ADMIN_EMAIL=ADMIN_EMAIL
ADMIN_PASSWORD=ADMIN_PASSWORD

CV_STORAGE_DIR=CV_STORAGE_DIR
CONTRACT_STORAGE_DIR=CONTRACT_STORAGE_DIR
MAX_FILE_SIZE=MAX_FILE_SIZE
MAX_REQUEST_SIZE=MAX_REQUEST_SIZE

AGENCY_NAME=AGENCY_NAME
AGENCY_ADDRESS=AGENCY_ADDRESS
AGENCY_COMPANY_NUMBER=AGENCY_COMPANY_NUMBER
AGENCY_LICENCE_NUMBER=AGENCY_LICENCE_NUMBER
AGENCY_JOINT_COMMITTEE=AGENCY_JOINT_COMMITTEE

SIGNATURE_CODE_VALIDITY_MINUTES=SIGNATURE_CODE_VALIDITY_MINUTES

MAIL_ENABLED=MAIL_ENABLED
MAIL_HOST=MAIL_HOST
MAIL_PORT=MAIL_PORT
MAIL_USERNAME=MAIL_USERNAME
MAIL_PASSWORD=MAIL_PASSWORD
MAIL_FROM=MAIL_FROM
MAIL_SMTP_AUTH=MAIL_SMTP_AUTH
MAIL_STARTTLS=MAIL_STARTTLS

FRONTEND_URL=FRONTEND_URL

# Jeu de donnees de demonstration : comptes test@*.com, offres, candidatures et
# missions. A laisser a false hors developpement.
DEMO_DATA_ENABLED=false
# Mot de passe des comptes de demonstration (sans effet si DEMO_DATA_ENABLED=false).
DEMO_DATA_PASSWORD=DEMO_DATA_PASSWORD

# Chiffrement au repos du numero de registre national et de l'IBAN.
# Au moins 32 caracteres, tires au hasard. A sauvegarder separement de la base :
# perdue, elle rend ces deux champs definitivement illisibles ; volee avec la base,
# elle annule la protection.
ENCRYPTION_KEY=ENCRYPTION_KEY

# Politique de conservation (RGPD). false tant que les durees ne sont pas arretees.
RETENTION_ENABLED=RETENTION_ENABLED
RETENTION_MESSAGE_MONTHS=24
RETENTION_CONTRACT_YEARS=5
RETENTION_DORMANT_MONTHS=24

# Prise en compte des en-tetes X-Forwarded-* : none en developpement (acces direct),
# native ou framework derriere un reverse proxy qui termine le TLS. Sans cela, le HSTS
# n'est pas emis et le quota par adresse compte toutes les requetes sur celle du proxy.
FORWARD_HEADERS_STRATEGY=FORWARD_HEADERS_STRATEGY

# Corps des emails simules dans la console : DEBUG en developpement, INFO en production.
MAIL_LOG_LEVEL=MAIL_LOG_LEVEL
