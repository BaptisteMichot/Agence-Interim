# Secrets et adresses personnelles de l'assemblage Docker.
#
# À copier en `.env` (à la racine du dépôt, à côté de compose.yml) et à remplir.
# Docker Compose le lit de lui-même ; git l'ignore.
#
#     cp .env.example .env
#
# Ne pas confondre avec `backend/.env`, qui configure l'application lancée directement
# sur le poste, hors conteneur. Les deux fichiers sont indépendants et peuvent porter des
# valeurs différentes : ce sont deux installations distinctes, avec deux bases distinctes.
#
# Tout ce qui n'est pas sensible — ports, chemins, identité de l'agence, réglages du
# serveur SMTP — est écrit en clair dans compose.yml. Seul ce qui suit est à fournir.

# --- Base de données ---
# Ce compte est créé dans le conteneur PostgreSQL au premier démarrage : ces valeurs le
# définissent, elles n'ont pas à correspondre à un compte existant sur la machine.
DB_USER=postgres
DB_PASSWORD=

# --- Sécurité ---
# Au moins 32 caractères chacun, tirés au hasard.
# La clé de chiffrement protège le registre national et l'IBAN : la changer rend
# illisibles les valeurs déjà écrites en base.
JWT_SECRET=
ENCRYPTION_KEY=

# --- Compte administrateur, créé au premier démarrage ---
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Envoi des emails ---
# Avec Gmail : un mot de passe d'application (16 caractères, sans espaces), la validation
# en deux étapes devant être active sur le compte. MAIL_FROM doit être le compte
# lui-même — Gmail refuse d'expédier au nom d'un domaine qu'il ne contrôle pas.
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# --- Jeu de démonstration ---
# Mot de passe commun aux comptes de démonstration.
DEMO_DATA_PASSWORD=

# Adresses des deux comptes de démonstration. Des boîtes que vous relevez réellement :
# la base du conteneur est neuve, ces comptes y sont donc recréés, et c'est sur ces
# adresses qu'arriveront les codes de signature et de réinitialisation.
# Avec Gmail, un sous-adressage suffit et ne demande aucune inscription :
#     DEMO_EMPLOYER_EMAIL=vous+employeur@gmail.com
DEMO_EMPLOYER_EMAIL=
DEMO_JOBSEEKER_EMAIL=
